# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# Original high-res banner images (too large for the repo — use WebP versions instead)
public/images/banner/*.png
public/images/banner/*.jpg

# jetbrains setting folder
.idea/
.claude/settings.local.json

# Local scratch space (large audio masters etc). Exclude the contents rather
# than the directory itself, so specific subdirectories can be re-included —
# git will not descend into an excluded directory to find exceptions.
var/*
!var/musicbrainz/