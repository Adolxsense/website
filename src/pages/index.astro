---
import Layout from '../layouts/Layout.astro';
import { songs } from '../data/songs';
import { releases } from '../data/releases';
import { preRelease as pre } from '../data/preRelease';

const featuredSongs = songs.slice(0, 4);
const latestReleases = releases.slice(0, 3);

const showPre = pre.active;
const preHeroBg = pre.heroBanner ? `${pre.heroBanner}-1920w.webp` : `${pre.cover.src}-1200w.webp`;
const preHook = pre.description.split('\n\n')[0];

/** Released record promoted with an "Out Now" hero slide. */
const featured = releases.find((r) => r.featured);
const featuredBg = featured
  ? `${featured.heroBanner ?? featured.cover?.src}-1920w.webp`
  : null;

/**
 * The hero can lead with one promo slide. An upcoming release takes priority
 * over a freshly released one.
 */
const heroPromoKind = showPre ? 'pre' : featured ? 'featured' : null;

/** Hero banner slides; a promo slide is prepended when there is one. */
const bannerSlides = ['banner-1', 'banner-2', 'banner-3', 'banner-4'];
const slideCount = bannerSlides.length + (heroPromoKind ? 1 : 0);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MusicGroup',
  '@id': 'https://adolxsense.com/#band',
  name: 'Adolxsense',
  url: 'https://adolxsense.com',
  description: 'Female-fronted Nu Metal and Alternative Rock band, channeling early-2000s rock through a modern cinematic lens. Songs for the things we never said, the pain we never showed, and the memories that still echo.',
  genre: ['Nu Metal', 'Alternative Rock', 'Post-Grunge', 'Alternative Metal'],
  member: {
    '@type': 'OrganizationRole',
    roleName: 'Lead vocalist',
    member: { '@type': 'Person', name: 'Christie' },
  },
  album: releases.map((r) => ({
    '@type': 'MusicAlbum',
    name: r.title,
    url: `https://adolxsense.com/releases/${r.slug}`,
  })),
  sameAs: [
    'https://open.spotify.com/artist/0E2Sa4BxDqWcleazYE7lUT',
    'https://music.apple.com/br/artist/adolxsense/1848634461',
    'https://www.youtube.com/@adolxsenseofficial',
    'https://www.instagram.com/adolxsense',
    'https://www.tiktok.com/@adolxsense',
    'https://www.facebook.com/adolxsense',
    'https://x.com/adolxsense',
  ],
  email: 'hey@adolxsense.com',
  logo: 'https://adolxsense.com/images/logo.svg',
  image: 'https://adolxsense.com/images/banner/banner-1-1920w.webp',
};

/** Map: songSlug → release cover */
const coverBySong = Object.fromEntries(
  releases
    .filter((r) => r.cover)
    .flatMap((r) => r.tracks.filter((t) => t.songSlug).map((t) => [t.songSlug!, r.cover!]))
);
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Adolxsense',
  url: 'https://adolxsense.com',
  inLanguage: 'en-US',
  publisher: { '@id': 'https://adolxsense.com/#band' },
};
---

<Layout brandFirst jsonLd={jsonLd} schemas={[websiteSchema]}>
  <!--
    The logo image is the visual headline, so the crawlable <h1> is
    screen-reader-only. It states exactly what the page is about.
  -->
  <h1 class="sr-only">
    Adolxsense — female-fronted Nu Metal and Alternative Rock band
  </h1>

  <!-- HERO -->
  <section class="hero">
    <!-- Rotating banner images -->
    <div class="hero__slides">
      {heroPromoKind && (
        <div class="banner-slide banner-slide--promo active">
          <div
            class="hero-promo__bg"
            style={`background-image:url(${heroPromoKind === 'pre' ? preHeroBg : featuredBg})`}
          ></div>
        </div>
      )}
      {bannerSlides.map((name, i) => (
        <div class={`banner-slide${!heroPromoKind && i === 0 ? ' active' : ''}`}>
          <img
            srcset={`/images/banner/${name}-480w.webp 480w, /images/banner/${name}-768w.webp 768w, /images/banner/${name}-1280w.webp 1280w, /images/banner/${name}-1920w.webp 1920w`}
            sizes="100vw"
            src={`/images/banner/${name}-1920w.webp`}
            alt=""
            class="banner-slide__img"
            fetchpriority={i === 0 ? 'high' : undefined}
            loading={i === 0 ? undefined : 'lazy'}
          />
        </div>
      ))}
    </div>
    <div class="hero__overlay"></div>
    <div class="hero__grid"></div>

    {heroPromoKind === 'pre' && (
      <div class="hero-promo is-visible" id="heroPromo">
        <p class="hero-promo__eyebrow"><span class="pulse-dot"></span> New Single &middot; Coming Soon</p>
        <h2 class="hero-promo__title">{pre.title}</h2>
        <p class="hero-promo__date">Out {pre.releaseDate}</p>
        <div class="hero-promo__actions">
          {pre.spotifyUrl && (
            <a href={pre.spotifyUrl} target="_blank" rel="noopener noreferrer" class="prerelease-presave-btn">
              <i class="fa-brands fa-spotify"></i>
              Pre-Save on Spotify
            </a>
          )}
          <a href="/pre-release" class="btn btn-ghost">Full Details &#8594;</a>
        </div>
      </div>
    )}

    {heroPromoKind === 'featured' && featured && (
      <div class="hero-promo is-visible" id="heroPromo">
        <p class="hero-promo__eyebrow">
          <span class="hero-promo__outnow">Out Now</span>
          New {featured.type} &middot; {featured.releaseDate}
        </p>
        <h2 class="hero-promo__title">{featured.title}</h2>
        {featured.tagline && <p class="hero-promo__tagline">&ldquo;{featured.tagline}&rdquo;</p>}
        <div class="hero-promo__actions">
          {featured.spotifyUrl && (
            <a href={featured.spotifyUrl} target="_blank" rel="noopener noreferrer" class="streaming-btn streaming-btn--lg streaming-btn--spotify">
              <i class="fa-brands fa-spotify"></i>
              Listen on Spotify
            </a>
          )}
          {featured.appleMusicUrl && (
            <a href={featured.appleMusicUrl} target="_blank" rel="noopener noreferrer" class="streaming-btn streaming-btn--lg streaming-btn--apple">
              <i class="fa-brands fa-apple"></i>
              Apple Music
            </a>
          )}
          <a href={`/releases/${featured.slug}`} class="btn btn-ghost">View Release &#8594;</a>
        </div>
      </div>
    )}

    <div class="hero__scroll">
      <div class="hero__scroll-line"></div>
      <span>Scroll</span>
    </div>
    <div class="hero__dots">
      {Array.from({ length: slideCount }).map((_, i) => (
        <button
          class={`hero__dot${i === 0 ? ' active' : ''}`}
          data-index={i}
          aria-label={heroPromoKind && i === 0 ? featured?.title ?? 'Featured' : `Slide ${heroPromoKind ? i : i + 1}`}
        ></button>
      ))}
    </div>
  </section>

  <script>
    const slides = Array.from(document.querySelectorAll('.banner-slide'));
    const dots   = Array.from(document.querySelectorAll('.hero__dot'));
    const heroPromo = document.getElementById('heroPromo');
    let current  = 0;
    let timer: ReturnType<typeof setInterval>;

    function goTo(index: number) {
      slides[current].classList.remove('active');
      dots[current].classList.remove('active');
      current = index;
      slides[current].classList.add('active');
      dots[current].classList.add('active');
      heroPromo?.classList.toggle('is-visible', current === 0);
    }

    function next() {
      goTo((current + 1) % slides.length);
    }

    function startTimer() {
      timer = setInterval(next, 6000);
    }

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        clearInterval(timer);
        goTo(Number(dot.dataset.index));
        startTimer();
      });
    });

    startTimer();
  </script>

  {showPre && (
  <section class="home-prerelease">
    <div class="home-prerelease__bg" style={`background-image:url(${pre.cover.src}-1200w.webp)`}></div>
    <div class="home-prerelease__overlay"></div>

    <div class="container home-prerelease__inner">
      <a href="/pre-release" class="home-prerelease__cover" aria-label={`${pre.title} — pre-release`}>
        <picture>
          <source srcset={`${pre.cover.src}-600w.webp 600w, ${pre.cover.src}-300w.webp 300w`} sizes="(max-width: 900px) 100vw, 380px" type="image/webp" />
          <img src={`${pre.cover.src}.jpg`} alt={pre.cover.alt} class="home-prerelease__cover-img" loading="lazy" width="600" height="600" />
        </picture>
        <span class="home-prerelease__badge">{pre.type} · Coming Soon</span>
      </a>

      <div class="home-prerelease__content">
        <p class="home-prerelease__eyebrow">
          <span class="pulse-dot"></span> New Single &middot; {pre.releaseDate}
        </p>
        <h2 class="home-prerelease__title">{pre.title}</h2>
        <p class="home-prerelease__desc">{preHook}</p>

        <div class="prerelease-countdown home-prerelease__countdown" id="homePreCountdown" data-target={pre.releaseDateISO}>
          <div class="countdown-unit"><span class="countdown-num" data-days>00</span><span class="countdown-label">Days</span></div>
          <div class="countdown-unit"><span class="countdown-num" data-hours>00</span><span class="countdown-label">Hours</span></div>
          <div class="countdown-unit"><span class="countdown-num" data-minutes>00</span><span class="countdown-label">Minutes</span></div>
          <div class="countdown-unit"><span class="countdown-num" data-seconds>00</span><span class="countdown-label">Seconds</span></div>
          <div class="countdown-out">Out Now</div>
        </div>

        <div class="home-prerelease__actions">
          {pre.spotifyUrl && (
            <a href={pre.spotifyUrl} target="_blank" rel="noopener noreferrer" class="prerelease-presave-btn">
              <i class="fa-brands fa-spotify"></i>
              Pre-Save on Spotify
            </a>
          )}
          <a href="/pre-release" class="btn btn-ghost">Full Details &#8594;</a>
        </div>
      </div>
    </div>
  </section>
  )}

  <script>
    const preRoot = document.getElementById('homePreCountdown');
    if (preRoot) {
      const t = new Date(preRoot.getAttribute('data-target') || '').getTime();
      const pel = {
        d: preRoot.querySelector('[data-days]'),
        h: preRoot.querySelector('[data-hours]'),
        m: preRoot.querySelector('[data-minutes]'),
        s: preRoot.querySelector('[data-seconds]'),
      };
      const p2 = (n: number) => String(n).padStart(2, '0');
      function preTick() {
        if (isNaN(t)) return;
        const diff = t - Date.now();
        if (diff <= 0) { preRoot.classList.add('is-out'); return; }
        if (pel.d) pel.d.textContent = String(Math.floor(diff / 86400000));
        if (pel.h) pel.h.textContent = p2(Math.floor((diff % 86400000) / 3600000));
        if (pel.m) pel.m.textContent = p2(Math.floor((diff % 3600000) / 60000));
        if (pel.s) pel.s.textContent = p2(Math.floor((diff % 60000) / 1000));
      }
      preTick();
      setInterval(preTick, 1000);
    }
  </script>

  <!-- LISTEN NOW STRIP -->
  <div class="listen-strip">
    <div class="container">
      <div class="listen-strip__inner">
        <div class="listen-strip__group">
          <p class="listen-strip__label">Listen on</p>
          <div class="listen-strip__links">
            <a href="https://open.spotify.com/artist/0E2Sa4BxDqWcleazYE7lUT?si=ILUDQ_W6SMO6fO95WEufxg" target="_blank" rel="noopener noreferrer" class="listen-btn listen-btn--spotify">
              <i class="fa-brands fa-spotify"></i>
              Spotify
            </a>
            <a href="https://music.apple.com/br/artist/adolxsense/1848634461" target="_blank" rel="noopener noreferrer" class="listen-btn listen-btn--apple">
              <i class="fa-brands fa-apple"></i>
              Apple Music
            </a>
          </div>
        </div>
        <div class="listen-strip__divider"></div>
        <div class="listen-strip__group">
          <p class="listen-strip__label">Featured Playlist</p>
          <div class="listen-strip__links">
            <a href="https://open.spotify.com/playlist/6vC0LHXP8eHQ69mUJwhvp4?si=43da85891933462f" target="_blank" rel="noopener noreferrer" class="listen-btn listen-btn--playlist listen-btn--spotify">
              <i class="fa-brands fa-spotify"></i>
              This is Adolxsense
            </a>
            <a href="https://music.apple.com/br/playlist/this-is-adolxsense/pl.u-XkD0YzJS4o2p4G?l=en" target="_blank" rel="noopener noreferrer" class="listen-btn listen-btn--playlist listen-btn--apple">
              <i class="fa-brands fa-apple"></i>
              This is Adolxsense
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ABOUT SECTION -->
  <section class="section about-section" id="about">
    <div class="container">
      <div class="about-header reveal">
        <p class="section-header__label">About</p>
        <img src="/images/logo.svg" alt="Adolxsense" class="about-header__logo" />
      </div>

      <div class="about-grid">
        <div class="about-grid__intro reveal">
          <p class="about-lead">
            Adolxsense is a Nu Metal and Alternative Rock project born for the emotions that never learned how to speak.
          </p>
          <p class="about-body-text">
            Built from the raw energy of early-2000s rock and shaped through a modern cinematic lens, Adolxsense blends heavy distorted guitars, haunting melodies, atmospheric textures, and deeply confessional lyrics. Every song is designed to feel like a memory you tried to bury, a conversation you never had, or a wound that still knows your name.
          </p>
          <p class="about-body-text">
            Fronted by the emotional voice of <strong>Christie</strong>, Adolxsense lives in the space between silence and explosion — where vulnerability becomes distortion, nostalgia becomes noise, and pain becomes something you can finally sing along to.
          </p>
        </div>

        <div class="about-grid__details reveal" style="--reveal-delay: 1">
          <div class="about-influences">
            <p class="about-influences__label">Sounds like</p>
            <p class="about-influences__list">
              Linkin Park · Evanescence · Breaking Benjamin · Staind · Avril Lavigne · Creed · Nickelback · Limp Bizkit · Nirvana · Green Day
            </p>
          </div>

          <p class="about-body-text">
            The sound carries echoes of a generation, but the world of Adolxsense is its own: empty roads at night, bedroom walls full of ghosts, words left unsent, scars hidden under ordinary days, and the quiet fight to become someone stronger than the pain that shaped you.
          </p>

          <p class="about-body-text">
            More than a band, Adolxsense is a fictional sonic universe — a collection of stories about loneliness, regret, self-destruction, survival, and the fragile hope that maybe tomorrow can still mean something.
          </p>
        </div>
      </div>

      <div class="about-closing reveal" style="--reveal-delay: 1">
        <p class="about-closing__lines">
          These are songs for the things we never said.<br />
          For the pain we never showed.<br />
          For the memories that still echo when everything else goes quiet.
        </p>
        <p class="about-closing__welcome">
          Welcome to Adolxsense.<br />
          <em>Turn it up. Feel what you buried.</em>
        </p>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- LATEST RELEASES SECTION -->
  <section class="section" id="releases-home">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-header__label">Discography</p>
        <h2 class="section-header__title">Latest <em>Releases</em></h2>
      </div>
      <div class="home-releases-grid">
        {latestReleases.map((release, i) => (
          <div class="home-release-card reveal" style={`--reveal-delay: ${i}`}>
            <a href={`/releases/${release.slug}`} class="home-release-card__cover-link">
              <div class="home-release-card__cover">
                {release.cover ? (
                  <picture>
                    <source
                      srcset={`${release.cover.src}-600w.webp 600w, ${release.cover.src}-300w.webp 300w`}
                      sizes="(max-width: 768px) 100vw, 400px"
                      type="image/webp"
                    />
                    <img
                      src={`${release.cover.src}.jpg`}
                      alt={release.cover.alt}
                      class="home-release-card__img"
                      loading="lazy"
                      width="600"
                      height="600"
                    />
                  </picture>
                ) : (
                  <div class="home-release-card__placeholder">{release.title}</div>
                )}
                <span class="release-card__type-badge">{release.type}</span>
              </div>
            </a>
            <div class="home-release-card__info">
              <a href={`/releases/${release.slug}`} class="home-release-card__title">{release.title}</a>
              <p class="home-release-card__date">{release.releaseDate}</p>
              {release.label && <p class="home-release-card__label">{release.label}</p>}
              <div class="home-release-card__streaming">
                {release.spotifyUrl && (
                  <a href={release.spotifyUrl} target="_blank" rel="noopener noreferrer" class="streaming-btn streaming-btn--spotify" aria-label="Listen on Spotify">
                    <i class="fa-brands fa-spotify"></i>
                    Spotify
                  </a>
                )}
                {release.appleMusicUrl && (
                  <a href={release.appleMusicUrl} target="_blank" rel="noopener noreferrer" class="streaming-btn streaming-btn--apple" aria-label="Listen on Apple Music">
                    <i class="fa-brands fa-apple"></i>
                    Apple Music
                  </a>
                )}
              </div>
              <a href={`/releases/${release.slug}`} class="home-release-card__more">
                View release &#8594;
              </a>
            </div>
          </div>
        ))}
      </div>
      <div style="margin-top: 48px; text-align: center;">
        <a href="/releases" class="btn btn-ghost">All Releases &#8594;</a>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- LATEST LYRICS SECTION -->
  <section class="section" id="music">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-header__label">Lyrics</p>
        <h2 class="section-header__title">Latest <em>Lyrics</em></h2>
      </div>
      <div class="songs-grid">
        {featuredSongs.map((song, i) => {
          const cover = coverBySong[song.slug];
          return (
            <a href={`/lyrics/${song.slug}`} class="song-card reveal" style={`--reveal-delay: ${i}`}>
              {cover && (
                <div class="song-card__cover">
                  <picture>
                    <source srcset={`${cover.src}-300w.webp`} type="image/webp" />
                    <img
                      src={`${cover.src}.jpg`}
                      alt={cover.alt}
                      class="song-card__cover-img"
                      loading="lazy"
                      width="300"
                      height="300"
                    />
                  </picture>
                </div>
              )}
              <div class="song-card__body">
                <span class="song-card__number">0{i + 1}</span>
                <h3 class="song-card__title">{song.title}</h3>
                <div class="song-card__meta">
                  {song.genre && <span class="tag">{song.genre}</span>}
                  {song.bpm && <span class="tag">{song.bpm} BPM</span>}
                </div>
                <p class="song-card__desc">{song.description}</p>
                <span class="song-card__arrow">&#8594;</span>
              </div>
            </a>
          );
        })}
      </div>
      <div style="margin-top: 48px; text-align: center;">
        <a href="/lyrics" class="btn btn-ghost">View All Lyrics &#8594;</a>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- VIDEOS PREVIEW -->
  <section class="section">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-header__label">Watch</p>
        <h2 class="section-header__title">Latest <em>Videos</em></h2>
      </div>
      <div class="videos-grid">
        {songs.slice(0, 3).map((song, i) => (
          <div class="video-card reveal" style={`--reveal-delay: ${i}`}>
            <div class="video-card__embed">
              {song.youtubeId ? (
                <iframe
                  src={`https://www.youtube.com/embed/${song.youtubeId}`}
                  title={song.title}
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                />
              ) : (
                <div class="video-card__placeholder">
                  <div class="video-card__placeholder-icon">&#9654;</div>
                  <span>Coming Soon</span>
                </div>
              )}
            </div>
            <div class="video-card__info">
              <div class="video-card__title">{song.title}</div>
              <div class="video-card__album">{song.album}</div>
            </div>
          </div>
        ))}
      </div>
      <div style="margin-top: 48px; text-align: center;">
        <a href="/videos" class="btn btn-ghost">All Videos &#8594;</a>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <section class="section" id="fansletter">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-header__label">Stay Connected</p>
        <h2 class="section-header__title">Join the <em>Fansletter</em></h2>
        <p class="section-header__sub">Be the first to hear about new releases, shows, and band news.</p>
      </div>

      <form
        action="https://assets.mailerlite.com/jsonp/2478376/forms/191620638290478405/subscribe"
        method="POST"
        class="fansletter-form reveal"
        style="--reveal-delay: 1"
        id="fansletter-form"
      >
        <input type="hidden" name="ml-submit" value="1" />
        <input type="hidden" name="anticsrf" value="true" />

        <div class="fansletter-form__row">
          <input
            type="text"
            name="fields[name]"
            placeholder="Your Name"
            class="fansletter-form__input"
            required
          />
          <input
            type="email"
            name="fields[email]"
            placeholder="Your Email"
            class="fansletter-form__input"
            required
          />
          <button type="submit" class="btn btn-primary fansletter-form__btn">
            <i class="fa-solid fa-envelope"></i> Subscribe
          </button>
        </div>

        <p class="fansletter-form__success" id="fansletter-success" hidden>
          You're in! Welcome to the Fansletter.
        </p>
      </form>
    </div>
  </section>

  <script>
    const form = document.getElementById('fansletter-form') as HTMLFormElement;
    const success = document.getElementById('fansletter-success') as HTMLElement;
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      await fetch(form.action, { method: 'POST', body: data, mode: 'no-cors' });
      form.querySelector('.fansletter-form__row')?.setAttribute('hidden', '');
      success.removeAttribute('hidden');
    });
  </script>
</Layout>
