---
import Layout from '../../layouts/Layout.astro';
import { songs } from '../../data/songs';
import { breadcrumbs, collection } from '../../lib/seo';

const description = 'Every Adolxsense song lyric, with Portuguese translations side by side. Letras e traduções em português de todas as músicas.';

const schemas = [
  collection({
    name: 'Adolxsense Lyrics',
    description,
    path: '/lyrics',
    items: songs.map((s) => ({ name: s.title, path: `/lyrics/${s.slug}` })),
  }),
  breadcrumbs([{ name: 'Lyrics', path: '/lyrics' }]),
];
---

<Layout
  title="Song Lyrics & Portuguese Translations"
  description={description}
  schemas={schemas}
>
  <div style="padding-top: 120px;">
    <div class="container">
      <div class="lyrics-hero reveal">
        <p class="section-header__label">All Songs</p>
        <h1 class="section-header__title">Lyrics</h1>
        <p class="hub-intro">
          Every Adolxsense song, with the Portuguese translation side by side.{' '}
          <span lang="pt-BR">Letras e traduções em português.</span>
        </p>
      </div>

      <div style="padding: 80px 0;">
        <div class="songs-grid">
          {songs.map((song, i) => (
            <a href={`/lyrics/${song.slug}`} class="song-card reveal" style={`--reveal-delay: ${i % 4}`}>
              <div class="song-card__body">
                <span class="song-card__number">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="song-card__title">{song.title}</h3>
                <div class="song-card__meta">
                  {song.genre && <span class="tag">{song.genre}</span>}
                  <span class="tag">{song.album}</span>
                </div>
                <p class="song-card__desc">{song.description}</p>
                <span class="song-card__arrow">&#8594;</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</Layout>
